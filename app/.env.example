# Elija exactamente un proveedor de clasificacion.
AI_CLASSIFIER_PROVIDER=anthropic
AI_CLASSIFIER_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY= 
# Para comparar OpenAI: cambie provider/model y use OPENAI_API_KEY.
OPENAI_API_KEY=

# Notas de voz de WhatsApp. Active ZDR en Groq antes de datos no sinteticos.
GROQ_API_KEY=
STT_MODEL=whisper-large-v3-turbo

# Meta WhatsApp Cloud API. Copie la version que muestra API Setup (por ejemplo vXX.X).
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
SESION_SAL=

# Compuertas de escritura: se mantienen apagadas hasta la prueba supervisada.
WHATSAPP_SEND_ENABLED=false
WHATSAPP_DEBOUNCE_MS=12000
APP_PUBLIC_URL=
PETICION_LINK_SECRET=
NOTIFICAR_ADMIN_TOKEN=

# Notas de voz en el simulador. Requiere GROQ_API_KEY con inferencia activa.
NOTAS_VOZ_DEMO=false

# Transcripcion: "groq" (por defecto) o "gemini".
# El tier gratuito de Gemini usa el contenido para mejorar productos de Google:
# solo admisible con el audio sintetico de la demo, nunca con voz real.
STT_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_STT_MODEL=gemini-3.6-flash

# Estado de la conversacion. Sin estas variables se usa un Map en memoria, que
# es suficiente en local: hay un solo proceso. En serverless NO alcanza -cada
# mensaje puede caer en otra instancia y la sesion se pierde-, asi que en el
# entorno desplegado hay que definirlas. Las pone la integracion de Upstash en
# Vercel; tambien se aceptan UPSTASH_REDIS_REST_URL / _TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=
