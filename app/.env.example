# Elija exactamente un proveedor de clasificacion.
AI_CLASSIFIER_PROVIDER=anthropic
AI_CLASSIFIER_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY= 
# Para comparar OpenAI: cambie provider/model y use OPENAI_API_KEY.
OPENAI_API_KEY=

# Notas de voz de WhatsApp. Active ZDR en Groq antes de datos no sinteticos.
GROQ_API_KEY=
STT_MODEL=whisper-large-v3-turbo

# Meta WhatsApp Cloud API. Copie la version que muestra API Setup (por ejemplo vXX.X).
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
SESION_SAL=

# Compuertas de escritura: se mantienen apagadas hasta la prueba supervisada.
WHATSAPP_SEND_ENABLED=false
WHATSAPP_DEBOUNCE_MS=12000
APP_PUBLIC_URL=
PETICION_LINK_SECRET=
NOTIFICAR_ADMIN_TOKEN=

# Notas de voz en el simulador. Requiere GROQ_API_KEY con inferencia activa.
NOTAS_VOZ_DEMO=false
